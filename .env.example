# Host ports exposed by Docker Compose
WEB_PORT=3000
API_PORT=3001

# Internal PostgreSQL configuration
POSTGRES_DB=domain_manager
POSTGRES_USER=domain_manager
POSTGRES_PASSWORD=domain_manager_local

LOG_LEVEL=info

# Internal server-to-server key. Change in real deployments.
INTERNAL_API_KEY=domain-manager-local-internal-key

# Postfix identity. For local portfolio use these defaults.
# For real Internet delivery replace them with your real mail hostname/domain.
POSTFIX_HOSTNAME=mail.domainmanager.local
POSTFIX_DOMAIN=domainmanager.local
POSTFIX_MESSAGE_SIZE_LIMIT=10485760

# Optional sender fallback. Normally configure sender name/address from
# Domain Manager -> Impostazioni -> Email.
EMAIL_FROM_NAME=Domain Manager
EMAIL_FROM_ADDRESS=

# Demo authentication / password reset
DEMO_ADMIN_EMAIL=admin@domainmanager.local
DEMO_ADMIN_INITIAL_PASSWORD=Admin123!
